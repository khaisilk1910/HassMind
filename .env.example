# ==============================
# Home Assistant existing server
# ==============================
# If HassMind runs on the SAME Linux host and both use network_mode: host:
HA_URL=http://127.0.0.1:8123
HA_TOKEN_FILE=/run/secrets/ha_token
HA_NOTIFY_SERVICE=notify.mobile_app_your_phone

# ==============================
# LLM - OpenAI compatible API
# ==============================
OPENAI_API_KEY_FILE=/run/secrets/openai_api_key
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6
MAX_TOOL_ROUNDS=10

# ==============================
# HassMind web/API
# ==============================
AGENT_NAME=HassMind
HOST=0.0.0.0
PORT=8090
API_TOKEN_FILE=/run/secrets/hassmind_api_token
DB_PATH=/data/hassmind.db
TIMEZONE=Asia/Bangkok

# ==============================
# Safety policy
# ==============================
# Direct HA service calls are ONLY allowed for these domains.
ALLOW_SERVICE_DOMAINS=light,switch,fan,climate,media_player,scene,input_boolean,input_number,input_select,number,select
# These domains are always blocked from direct service calls.
DENY_SERVICE_DOMAINS=shell_command,hassio,homeassistant,lock,alarm_control_panel,cover,update,button
APPROVAL_TTL_MINUTES=120
AUTO_APPLY_AFTER_APPROVAL=true

# ==============================
# Realtime / automation engine
# ==============================
SCHEDULER_ENABLED=true
EVENT_AGENT_ENABLED=true
EVENT_RETENTION=5000

# ==============================
# Optional SearXNG web search
# Example: http://127.0.0.1:8081
# ==============================
SEARXNG_URL=

# ==============================
# Optional Telegram
# ==============================
TELEGRAM_BOT_TOKEN_FILE=/run/secrets/telegram_bot_token
TELEGRAM_ALLOWED_CHAT_IDS=

# Knowledge / skills
KNOWLEDGE_DIR=/knowledge
SKILLS_DIR=/app/config/skills
MCP_CONFIG=/app/config/mcp_servers.yaml

# Portainer can alternatively provide direct environment variables instead of secret files:
# HA_TOKEN=...
# API_TOKEN=...
# TELEGRAM_BOT_TOKEN=...

# =============================================================
# Companion containers reviewed from the uploaded projects
# HassMind uses host networking, so these default to localhost.
# Enable only the services you actually run.
# =============================================================
INTEGRATION_HTTP_TIMEOUT=15
INTEGRATION_HEALTH_TIMEOUT=3

# camera-tts-ezviz (default API port 8124)
CAMERA_TTS_ENABLED=false
CAMERA_TTS_URL=http://127.0.0.1:8124
CAMERA_TTS_API_KEY_FILE=/run/secrets/camera_tts_api_key
CAMERA_TTS_API_KEY=
CAMERA_TTS_ALLOW_ACTIONS=true

# facedetect / IRIS (commonly published as 8080:80; use 8181 if that is your stack)
FACEDETECT_ENABLED=false
FACEDETECT_URL=http://127.0.0.1:8080

# zalo-bot-server (default port 3000)
ZALO_ENABLED=false
ZALO_URL=http://127.0.0.1:3000
ZALO_USERNAME=admin
ZALO_PASSWORD_FILE=/run/secrets/zalo_password
ZALO_PASSWORD=
ZALO_DEFAULT_ACCOUNT=
ZALO_ALLOW_SEND=false
# Incoming webhook from Zalo server -> HassMind. Keep agent auto-reply off until tested.
ZALO_WEBHOOK_ENABLED=false
ZALO_WEBHOOK_SECRET_FILE=/run/secrets/zalo_webhook_secret
ZALO_WEBHOOK_SECRET=
ZALO_AUTO_REGISTER_WEBHOOK=false
# Must be reachable by zalo-bot-server. With both stacks on host network, localhost works.
ZALO_WEBHOOK_CALLBACK_BASE=http://127.0.0.1:8090
ZALO_AGENT_REPLY_ENABLED=false
# Comma-separated raw thread IDs allowed to command the agent. Empty = no auto-reply. Use * only if you intentionally trust every inbound thread.
ZALO_AGENT_ALLOWED_THREAD_IDS=

# wyoming-vietnamese-prosody (default Wyoming TCP port 10300)
# HassMind only health-checks TCP directly; speech goes through Home Assistant tts.speak.
WYOMING_ENABLED=false
WYOMING_HOST=127.0.0.1
WYOMING_PORT=10300
WYOMING_ALLOW_TTS=true

# Home Assistant custom components from the uploaded projects:
# EVN-CSKH-Monitor, am-lich-viet-nam, shopping_history, yt_dlp_hass.
HA_CUSTOM_INTEGRATIONS_ENABLED=true
SHOPPING_ALLOW_MUTATIONS=false
SHOPPING_ALLOW_DELETE=false
YTDLP_ALLOW_PLAYBACK=true
YTDLP_ALLOW_DOWNLOADS=false
